{
  "name": "@shopflow/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tenant-context": {
      "types": "./dist/tenant-context.d.ts",
      "import": "./dist/tenant-context.js"
    }
  },
  "files": ["dist", "prisma"],
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "@shopflow/shared-types": "workspace:*",
    "prisma": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "22.19.17",
    "tsx": "^4.19.2",
    "typescript": "5.9.3"
  }
}
