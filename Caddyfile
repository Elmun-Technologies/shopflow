# Caddy konfiguratsiyasi — Avtomatik HTTPS Let's Encrypt orqali
#
# {$DOMAIN} va {$EMAIL} docker-compose.yml dan environment'ga kelib tushadi.
# Lokal sinov uchun DOMAIN=localhost qo'ying — Caddy ichki sertifikat ishlatadi.

{
	email {$EMAIL}
	# Lokal sinov uchun:
	# auto_https disable_redirects
}

{$DOMAIN} {
	encode zstd gzip

	# Reverse proxy nginx konteynerga
	reverse_proxy shopflow:80 {
		health_uri /health
		health_interval 30s
		health_timeout 3s
	}

	# Qo'shimcha xavfsizlik headerlari (nginx allaqachon qo'shadi, lekin Caddy ham yuborgani yaxshi)
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Loglar
	log {
		output file /data/access.log {
			roll_size 10mb
			roll_keep 5
		}
		format console
	}
}
