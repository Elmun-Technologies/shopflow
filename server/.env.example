# Server
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Public URL (Telegram webhook uchun) - production'da to'ldiring
# Development'da bo'sh qoldiring (long polling ishlatiladi)
PUBLIC_URL=

# Database (SQLite — bu MVP uchun, production'da Postgres URL beriladi)
DATABASE_URL=./data/shopflow.db

# Auth
JWT_SECRET=change_me_to_random_64_byte_hex_string
JWT_EXPIRES_IN=24h

# Bot tokenlarni shifrlash (32 byte hex)
ENCRYPTION_KEY=change_me_to_64_char_hex_string
