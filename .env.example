# ShopFlow Production .env namunasi
# Real qiymatlarga to'ldiring va `.env` fayl sifatida saqlang.

# ─── Domains ────────────────────────────────────────────────────────────
# Frontend (Mini App va admin dashboard) joylashgan URL
WEB_URL=https://app.shopflow.uz

# Backend webhook URL (Telegram, MoySklad, Click, Payme bu URL'ga so'rov yuboradi)
PUBLIC_URL=https://api.shopflow.uz

# Web container HTTP porti (default 80 — domen reverse-proxy bilan)
WEB_PORT=80

# ─── Auth ───────────────────────────────────────────────────────────────
# Random 64-belgili hex (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=__GENERATE_RANDOM_HEX_64__
JWT_EXPIRES_IN=24h

# Bot tokenlarni shifrlash (32 byte hex)
ENCRYPTION_KEY=__GENERATE_RANDOM_HEX_64__

# ─── Database ───────────────────────────────────────────────────────────
# SQLite (volume ichida)
DATABASE_URL=/data/shopflow.db

# Production'da Postgres'ga ko'chsangiz:
# DATABASE_URL=postgres://user:pass@db:5432/shopflow
