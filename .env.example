# ShopFlow production environment
# Bu faylni `.env` deb nusxa qiling va o'z qiymatlaringizni qo'ying

# === Caddy / Domain ===
DOMAIN=shop-flow.uz
EMAIL=admin@shop-flow.uz
# To'lov webhook, MoySklad callback va Telegram Mini App URL'lari uchun
PUBLIC_URL=https://shop-flow.uz

# === Postgres ===
POSTGRES_DB=shopflow
POSTGRES_USER=shopflow
POSTGRES_PASSWORD=changeme-strong-password

# === Backend ===
# JWT secret — kamida 32 belgi (openssl rand -hex 32)
JWT_SECRET=replace-with-openssl-rand-hex-32-output
# 3rd-party API tokenlari (Sales Doctor, Click/Payme/Uzum) shifrlash kaliti.
# Kiritilmasa JWT_SECRET ishlatiladi (lekin alohida bo'lgani xavfsizroq —
# JWT rotatsiyasi shifrlangan ma'lumotlarga ta'sir qilmaydi).
# SECRETS_ENCRYPTION_KEY=openssl-rand-hex-32-different-from-JWT
# Frontend domain (CORS uchun, vergul bilan ajratiladi)
CORS_ORIGIN=https://shop-flow.uz
# Log darajasi: trace|debug|info|warn|error
# LOG_LEVEL=info

# === Seed (birinchi marta tenant yaratish uchun) ===
SEED_TENANT_SLUG=demo
SEED_TENANT_NAME=ShopFlow Demo
SEED_EMAIL=admin@shopflow.local
SEED_PASSWORD=ChangeMeNow123!
SEED_USER_NAME=Admin

# === AI assistant (ixtiyoriy) ===
# Telegram bot mijoz xabarlariga aqlli javob qaytarishi uchun.
# Kalit sozlanmasa, bot oddiy "Xabaringiz qabul qilindi" javobi bilan ishlaydi.
# Olish: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...

# === SMS (Eskiz.uz — ixtiyoriy) ===
# ESKIZ_LOGIN=email@example.com
# ESKIZ_PASSWORD=your-eskiz-password
# ESKIZ_FROM=ShopFlow

# === Sentry error tracking (ixtiyoriy) ===
# Backend: https://sentry.io dan yangi Node.js loyiha yarating
# SENTRY_DSN=https://xxx@sentry.io/yyy

# === Backup ===
# BACKUP_DIR=/app/backups
# RETENTION_DAYS=7
