# ShopFlow production environment
# Bu faylni `.env` deb nusxa qiling va o'z qiymatlaringizni qo'ying

# === Caddy / Domain ===
DOMAIN=shopflow.example.com
EMAIL=admin@example.com

# === Postgres ===
POSTGRES_DB=shopflow
POSTGRES_USER=shopflow
POSTGRES_PASSWORD=changeme-strong-password

# === Backend ===
# JWT secret — kamida 32 belgi (openssl rand -hex 32)
JWT_SECRET=replace-with-openssl-rand-hex-32-output
# Frontend domain (CORS uchun, vergul bilan ajratiladi)
CORS_ORIGIN=https://shopflow.example.com

# === Seed (birinchi marta tenant yaratish uchun) ===
SEED_TENANT_SLUG=demo
SEED_TENANT_NAME=ShopFlow Demo
SEED_EMAIL=admin@shopflow.local
SEED_PASSWORD=ChangeMeNow123!
SEED_USER_NAME=Admin
