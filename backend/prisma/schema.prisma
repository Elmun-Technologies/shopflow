// ShopFlow multi-tenant schema
// Har bir tenant — alohida tashkilot. Barcha business rows tenant_id ga bog'langan.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============== TENANT & AUTH ==============

model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  currency  String   @default("UZS")
  timezone  String   @default("Asia/Tashkent")
  locale    String   @default("uz")
  // Narxlash breakdown (management ko'rinishi) — mahsulot narxiga nisbatan foiz.
  // Admin panel + hisobotlarda yetkazib berish va xizmat xarajatlarini ko'rsatadi.
  deliveryPct Float  @default(3)
  servicePct  Float  @default(15)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  leads           Lead[]
  orders          Order[]
  products        Product[]
  customers       Customer[]
  channels        Channel[]
  interactions    Interaction[]
  categories      Category[]
  storefront      Storefront?
  moyskladAccount MoyskladAccount?
  salesDoctorAccount SalesDoctorAccount?
  salesDoctorRetries SalesDoctorRetry[]
  oneCAccount     OneCAccount?
  oneCImportLogs  OneCImportLog[]
  syncJobs        SyncJob[]
  webhookEvents   WebhookEvent[]
  outboundWebhooks OutboundWebhook[]
  pushSubscriptions PushSubscription[]
  popups          Popup[]
  saleCampaigns   SaleCampaign[]
  abandonedCarts  AbandonedCart[]
  auditLogs       AuditLog[]
  paymentMethods  PaymentMethod[]
  conversations   Conversation[]
  segments        CustomerSegment[]
  reviews         Review[]
  promoCodes      PromoCode[]
  promoUsages     PromoUsage[]
  deliveryZones   DeliveryZone[]
  deliveryMethods DeliveryMethod[]
  deliveryOrders  DeliveryOrder[]
  apiKeys         ApiKey[]
  notifSettings   TenantNotifSettings?
  loyaltyAccounts LoyaltyAccount[]
  loyaltyRules    LoyaltyRule[]
  botSequences    BotSequence[]
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  AGENT
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String
  passwordHash String?
  googleId     String?  @unique
  name         String
  role         UserRole @default(AGENT)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedLeads  Lead[]  @relation("LeadAssignee")
  assignedOrders Order[] @relation("OrderAssignee")
  orderNotes     OrderNote[]
  auditLogs      AuditLog[]
  assignedConversations Conversation[]        @relation("ConversationAssignee")
  conversationMessages  ConversationMessage[] @relation("ConversationMessageAuthor")
  moderatedReviews      Review[]              @relation("ReviewModerator")
  refreshTokens  RefreshToken[]
  pushSubscriptions PushSubscription[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

// ============== CHANNELS ==============
// Channel — tenantning marketing/lead manbai (Telegram bot, Instagram page, web form, ...)

enum ChannelType {
  WEBSITE
  LANDING_PAGE
  INSTAGRAM
  TELEGRAM
  FACEBOOK
  WHATSAPP
  EMAIL
  PHONE
  REFERRAL
  GOOGLE_ADS
  YANDEX_DIRECT
  MARKETPLACE
  OFFLINE
}

model Channel {
  id         String      @id @default(cuid())
  tenantId   String
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type       ChannelType
  name       String
  config     Json        @default("{}")
  webhookKey String      @unique @default(cuid()) // tenantga xos webhook URL kaliti
  active     Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  leads         Lead[]
  orders        Order[]
  conversations Conversation[]

  @@index([tenantId, type])
}

// ============== CRM: LEAD ==============

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum LeadPriority {
  HIGH
  MEDIUM
  LOW
}

model Lead {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code        String // human-readable, "LID-2024001"
  name        String
  phone       String?
  email       String?
  company     String?
  position    String?
  location    String?
  status      LeadStatus   @default(NEW)
  priority    LeadPriority @default(MEDIUM)
  value       Decimal      @default(0) @db.Decimal(14, 2)
  currency    String       @default("UZS")
  notes       String?
  tags        String[]     @default([])
  utmSource   String?
  utmMedium   String?
  utmCampaign String?

  channelId String?
  channel   Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  assigneeId String?
  assignee   User?   @relation("LeadAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  lastContactAt  DateTime?
  nextFollowUpAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  interactions Interaction[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, channelId])
  @@index([tenantId, createdAt])
}

enum InteractionType {
  CALL
  EMAIL
  SMS
  WHATSAPP
  TELEGRAM
  MEETING
  NOTE
  STATUS_CHANGE
}

enum InteractionDirection {
  INBOUND
  OUTBOUND
}

model Interaction {
  id        String               @id @default(cuid())
  tenantId  String
  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId    String
  lead      Lead                 @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      InteractionType
  direction InteractionDirection
  content   String
  duration  Int? // sekundlarda (qo'ng'iroq/uchrashuv uchun)
  createdBy String // user name yoki "system"
  createdAt DateTime             @default(now())

  @@index([tenantId, leadId, createdAt])
}

// ============== CATALOG ==============

model Category {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  imageUrl  String?
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryTree")
  createdAt DateTime   @default(now())

  // MoySklad sync uchun (productfolder)
  moyskladId      String?
  moyskladUpdated DateTime?

  // Sales Doctor sync uchun (productCategory)
  salesDoctorId String?

  // 1C CommerceML sync uchun — Классификатор/Группы/Группа/Ид (GUID)
  oneCId String?

  products Product[]

  @@unique([tenantId, slug])
  @@unique([tenantId, moyskladId])
  @@unique([tenantId, salesDoctorId])
  @@unique([tenantId, oneCId])
  @@index([tenantId])
}

model Product {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sku         String
  name        String
  description String?
  price       Decimal  @default(0) @db.Decimal(14, 2)
  oldPrice    Decimal? @db.Decimal(14, 2) // chegirma uchun (eski narx)
  currency    String   @default("UZS")
  stock       Int      @default(0)
  active      Boolean  @default(true)
  featured    Boolean  @default(false) // Vitrina'da ko'rsatish uchun bayroq
  imageUrl    String? // asosiy rasm URL
  images      String[] @default([]) // qo'shimcha rasmlar

  // Public API (v1) uchun barqaror URL identifikatori — tenant ichida unique.
  // Mavjud mahsulotlarga backfill qilinadi, yangilarda name'dan avto-generatsiya.
  // Nullable: db push xavfsiz bo'lishi uchun (eski qatorlar NULL → backfill).
  slug   String?
  // Ishlab chiqarilgan davlat — public /products filtri (origin) uchun.
  origin String?
  // Boy marketing kontenti (public API Product detali uchun). Ixtiyoriy.
  // Shakl: { tagline, highlights[], benefits[], ingredients[], howToUse,
  //          faq[], servings, bespoke, ... } yoki per-locale: { uz:{...}, ru:{...} }.
  // Admin UI alohida PR'da — hozircha DB/seed orqali to'ldiriladi.
  content Json?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Sale campaign aksiyasi (ixtiyoriy)
  saleCampaignId String?
  saleCampaign   SaleCampaign? @relation(fields: [saleCampaignId], references: [id], onDelete: SetNull)

  // MoySklad sync uchun
  moyskladId      String?
  moyskladUpdated DateTime?
  source          ProductSource @default(MANUAL)

  // Sales Doctor sync uchun
  salesDoctorId String?

  // 1C CommerceML sync uchun — Товар/Ид (GUID, xarakteristikali bo'lsa "guid#guid")
  oneCId      String?
  oneCUpdated DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]

  // Combo / qo'shimcha mahsulotlar (Amazon-style "Frequently bought together")
  comboAddons     ProductAddon[] @relation("ComboMain")
  belongsToCombos ProductAddon[] @relation("ComboAddon")

  // Wishlist / favorites
  wishlistedBy WishlistItem[]

  reviews Review[]

  @@unique([tenantId, sku])
  @@unique([tenantId, slug])
  @@unique([tenantId, moyskladId])
  @@unique([tenantId, salesDoctorId])
  @@unique([tenantId, oneCId])
  @@index([tenantId, active])
  @@index([tenantId, featured])
  @@index([tenantId, saleCampaignId])
  @@index([tenantId, origin])
}

enum ProductSource {
  MANUAL
  MOYSKLAD
  ONEC
}

// ============== STOREFRONT (Vitrina) ==============
// Har bir tenantning bitta Vitrina layout'i bor.
// Vitrina — bu Telegram Mini App, web katalog va veb-sayt uchun
// umumiy konfiguratsiya: bloklar tartibi, brand sozlamalari.

model Storefront {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Bloklar tartibi va sozlamalari (drag-drop builder natijasi)
  // Misol: [{ id, type, title, enabled, settings: {...} }]
  blocks Json @default("[]")

  // Brand sozlamalari: logo, ranglar, shrift
  // { name, logoUrl, primaryColor, secondaryColor, contactPhone, ... }
  brand Json @default("{}")

  // Do'kon turi: "multi" — ko'p mahsulotli katalog (default),
  // "single" — bitta mahsulotga qaratilgan landing (single-product funnel).
  storeMode String @default("multi")

  // Single rejimda sotiladigan mahsulot id'si.
  // Oddiy string (FK emas) — mahsulot o'chirilsa Storefront buzilmasin;
  // mavjudligi read-time'da tekshiriladi.
  singleProductId String?

  // Public bo'lib turishi (sayt yopilishi mumkin)
  published Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============== CUSTOMERS ==============

model Customer {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  location  String?
  notes     String?
  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Profil maydonlari — Mini App'dagi mijoz kabineti uchun
  firstName  String?
  lastName   String?
  patronymic String?
  birthDate  DateTime?
  gender     String?   // "male" | "female"
  language   String    @default("uz")
  avatar     String?

  // Telegram Mini App orqali tanish — keyinchalik "Mening buyurtmalarim"
  telegramUserId BigInt?
  telegramUsername String?

  // Notification preferences — har bir kanal alohida o'chirilishi mumkin.
  // Default — hammasi yoqilgan; foydalanuvchi xohlasa Profile'dan o'chiradi.
  notifyOrderUpdates    Boolean @default(true)
  notifyCartAbandonment Boolean @default(true)
  notifyPromotions      Boolean @default(true)

  // Referral graph — kim taklif qilgan (Customer.id), nechta odamga taklif yuborgan
  referredByCustomerId String?
  referredByCustomer   Customer?  @relation("Referrals", fields: [referredByCustomerId], references: [id], onDelete: SetNull)
  referrals            Customer[] @relation("Referrals")

  // MoySklad sync uchun (counterparty)
  moyskladId      String?
  moyskladUpdated DateTime?

  // Sales Doctor sync uchun
  salesDoctorId String?

  orders        Order[]
  addresses     CustomerAddress[]
  wishlist      WishlistItem[]
  conversations Conversation[]
  reviews       Review[]
  promoUsages   PromoUsage[]
  loyaltyAccount LoyaltyAccount?
  botEnrollments BotSequenceEnrollment[]

  @@unique([tenantId, moyskladId])
  @@unique([tenantId, salesDoctorId])
  @@index([tenantId, email])
  @@index([tenantId, phone])
  @@index([tenantId, telegramUserId])
  @@index([referredByCustomerId])
}

// Mijoz sevimli mahsulotlari
model WishlistItem {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenantId   String

  createdAt DateTime @default(now())

  @@unique([customerId, productId])
  @@index([customerId])
  @@index([tenantId, productId])
}

// Mijoz manzillar kitobi — Mini App'dagi address chips, checkout autofill
model CustomerAddress {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tenantId   String

  label      String   // "Uy", "Ish", "Onamning uyi"
  city       String?
  street     String   // ko'cha + uy raqami
  apartment  String?
  notes      String?
  isDefault  Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([tenantId, customerId])
}

// ============== ORDERS ==============

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
  REFUNDED
}

model Order {
  id       String      @id @default(cuid())
  tenantId String
  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code     String // "ORD-7523"
  status   OrderStatus @default(PENDING)
  total    Decimal     @default(0) @db.Decimal(14, 2)
  currency String      @default("UZS")
  notes    String?

  // Yetkazib berish manzili (mijoz GPS orqali yuborishi mumkin)
  shippingAddress String?
  shippingLat     Decimal? @db.Decimal(10, 7)
  shippingLng     Decimal? @db.Decimal(10, 7)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  channelId String?
  channel   Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  assigneeId String?
  assignee   User?   @relation("OrderAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  // MoySklad sync uchun (customerorder)
  moyskladId       String?
  moyskladUpdated  DateTime?
  pushedToMoysklad Boolean   @default(false)

  // Sales Doctor sync uchun (push qilingach SD_id saqlanadi)
  salesDoctorId      String?
  pushedToSalesDoctor Boolean @default(false)

  // Promo kod
  promoCodeId    String?
  promoCode      PromoCode? @relation("OrderPromo", fields: [promoCodeId], references: [id], onDelete: SetNull)
  promoDiscount  Decimal?   @db.Decimal(14, 2)

  // To'lov holati — payment webhook tasdiqlaganda yangilanadi
  paid   Boolean   @default(false)
  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items          OrderItem[]
  orderNotes     OrderNote[]
  deliveryOrder  DeliveryOrder?
  promoUsage     PromoUsage?

  @@unique([tenantId, code])
  @@unique([tenantId, moyskladId])
  @@index([tenantId, status])
  @@index([tenantId, channelId])
  @@index([tenantId, createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  qty       Int
  price     Decimal @db.Decimal(14, 2)

  @@index([orderId])
  @@index([productId])
}

// Buyurtmaga ichki izoh / kommentariya (admin team'i o'rtasida)
model OrderNote {
  id       String @id @default(cuid())
  tenantId String
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  authorId   String?
  author     User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName String? // snapshot — author o'chirilganda ham ko'rinadi

  content String @db.Text

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([tenantId, createdAt])
}

// Audit log — kim, qachon, nima qildi (cross-cutting tracking)
model AuditLog {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  actorId   String?
  actor     User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorName String? // snapshot

  action       String // "CREATE", "UPDATE", "DELETE", "STATUS_CHANGE", "ASSIGN", "NOTE_ADDED", ...
  resourceType String // "order", "product", "lead", "customer", ...
  resourceId   String

  summary String? // foydalanuvchi uchun bir qatorli xabar ("Status: Yangi → Tayyorlanmoqda")
  changes Json?   // batafsil diff (ixtiyoriy)

  createdAt DateTime @default(now())

  @@index([tenantId, resourceType, resourceId, createdAt])
  @@index([tenantId, createdAt])
}

// ============== PAYMENTS ==============

enum ConversationStatus {
  ACTIVE
  WAITING
  RESOLVED
  ARCHIVED
  SPAM
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

// Mijoz suhbatlari — admin Chat sahifasida ko'rinadi
model Conversation {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  channelId String?
  channel   Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  // Auth'siz identifikator — mijoz ro'yxatdan o'tmagan bo'lsa
  externalUserId String? // Telegram user id, WhatsApp raqami va h.k.
  customerName   String? // snapshot
  customerAvatar String?

  status ConversationStatus @default(ACTIVE)

  assigneeId String?
  assignee   User?   @relation("ConversationAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  lastMessageAt      DateTime?
  lastMessagePreview String?
  unreadCount        Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ConversationMessage[]

  @@index([tenantId, status, lastMessageAt])
  @@index([tenantId, channelId])
  @@index([tenantId, externalUserId])
}

model ConversationMessage {
  id             String @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  direction MessageDirection
  content   String           @db.Text

  authorId   String?
  author     User?   @relation("ConversationMessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  authorName String? // snapshot

  externalId String? // Telegram message id — dedup uchun

  sentAt DateTime @default(now())
  read   Boolean  @default(false)

  @@index([conversationId, sentAt])
  @@index([conversationId, direction, read])
}

// ============== PRODUCT REVIEWS ==============

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id        String @id @default(cuid())
  tenantId  String
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Mijoz — Mini App'dan kelgan bo'lsa Customer ulangan
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName String // snapshot — Customer o'chirilsa ham qoladi

  rating  Int    // 1..5
  text    String @db.Text
  photos  String[] @default([])

  status     ReviewStatus @default(PENDING)
  // Moderatsiya
  moderatedById String?
  moderatedBy   User?   @relation("ReviewModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  moderatedAt   DateTime?
  // Rad etish sababi (status=REJECTED bo'lsa)
  rejectReason String?

  createdAt DateTime @default(now())

  @@index([tenantId, status, createdAt])
  @@index([tenantId, productId, status])
  @@index([customerId])
}

// ============== CUSTOMER SEGMENTS ==============

enum SegmentType {
  AUTOMATIC // Conditions asosida — Customer query orqali hisoblanadi
  MANUAL    // Operator qo'lda mijozlar tanlaydi — SegmentMember orqali
  SMART     // AI tomondan dinamik (kelajakda)
}

model CustomerSegment {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String
  description String      @default("")
  type        SegmentType @default(MANUAL)
  active      Boolean     @default(true)

  // Conditions — [{ field, operator, value, value2? }] sifatida saqlanadi
  // (faqat AUTOMATIC va SMART uchun)
  conditions Json @default("[]")

  tags String[] @default([])

  // Cache: oxirgi marta qachon hisoblangan + qancha a'zo
  cachedCount       Int       @default(0)
  cachedCountAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members SegmentMember[]

  @@index([tenantId, active])
}

// Faqat MANUAL segmentlar uchun: ma'lum mijozlarni qo'lda biriktirish
model SegmentMember {
  id         String @id @default(cuid())
  segmentId  String
  segment    CustomerSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  customerId String
  tenantId   String

  addedAt DateTime @default(now())

  @@unique([segmentId, customerId])
  @@index([tenantId, segmentId])
  @@index([customerId])
}

// ============== PAYMENTS (existing) ==============

enum PaymentMethodStatus {
  ACTIVE
  INACTIVE
  PENDING
  ERROR
}

model PaymentMethod {
  id       String              @id @default(cuid())
  tenantId String
  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  code     String // "click" | "payme" | "uzum" | "alif" | "cash" | ...
  name     String // "Click", "Payme", "Naqd to'lov"
  status   PaymentMethodStatus @default(INACTIVE)
  type     String              @default("instant") // "instant" | "installment" | "cash"

  // Provider config — merchant id, api key, etc.
  // Maxfiy ma'lumotlar — frontend ko'rmaydi (faqat boolean "configured")
  config Json @default("{}")

  // Limitlar va komissiya
  minAmount         Decimal? @db.Decimal(14, 2)
  maxAmount         Decimal? @db.Decimal(14, 2)
  commissionPercent Decimal? @db.Decimal(5, 2)

  testMode    Boolean @default(true)
  autoConfirm Boolean @default(false)

  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions PaymentTransaction[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
}

enum PaymentTxStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  CANCELLED
}

model PaymentTransaction {
  id       String @id @default(cuid())
  tenantId String

  methodId String
  method   PaymentMethod @relation(fields: [methodId], references: [id], onDelete: Cascade)

  // Bog'liq buyurtma (ixtiyoriy — boshqa to'lov turlari ham bo'lishi mumkin)
  orderId String?

  // Provider tomondan kelgan tashqi transaction id (idempotency)
  externalId String?

  amount     Decimal         @db.Decimal(14, 2)
  currency   String          @default("UZS")
  status     PaymentTxStatus @default(PENDING)
  commission Decimal?        @db.Decimal(14, 2)

  // Provider'dan qaytgan xom payload
  payload Json?

  // Xato xabari (status=FAILED bo'lganda)
  errorMessage String?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@unique([tenantId, methodId, externalId])
  @@index([tenantId, status, createdAt])
  @@index([orderId])
}

// ============== MoySklad Integration ==============

enum MoyskladStatus {
  DISCONNECTED
  CONNECTING
  CONNECTED
  ERROR
}

model MoyskladAccount {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // AES-256-GCM bilan shifrlangan bearer token: "iv:authTag:ciphertext" (hex)
  encryptedToken String
  accountUuid    String?
  accountName    String?
  status         MoyskladStatus @default(DISCONNECTED)

  connectedAt   DateTime?
  lastSyncAt    DateTime?
  lastWebhookAt DateTime?
  lastError     String?

  // Sync uchun cursor — keyingi marta shu vaqtdan keyin o'zgartirilganlarini olamiz
  productsSyncCursor  DateTime?
  customersSyncCursor DateTime?
  ordersSyncCursor    DateTime?

  // MoySklad'ga ro'yxatdan o'tkazgan webhook'lar id'lari (uzilish/qayta ulanishda tozalash uchun)
  webhookIds String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SyncJobType {
  INITIAL_IMPORT
  INCREMENTAL_PRODUCTS
  INCREMENTAL_CUSTOMERS
  INCREMENTAL_ORDERS
  PUSH_ORDER
}

enum SyncJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

model SyncJob {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type           SyncJobType
  status         SyncJobStatus @default(QUEUED)
  progress       Int           @default(0) // 0..100
  totalItems     Int           @default(0)
  processedItems Int           @default(0)
  startedAt      DateTime?
  finishedAt     DateTime?
  error          String?
  details        Json          @default("{}")
  createdAt      DateTime      @default(now())

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

// ============== Sales Doctor Integration ==============

enum SalesDoctorStatus {
  DISCONNECTED
  CONNECTING
  CONNECTED
  ERROR
}

model SalesDoctorAccount {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Sales Doctor instance domain — har tenant'da o'z subdomeni (`mijoz.salesdoctor.uz`)
  domain            String
  login             String
  encryptedPassword String  // re-login uchun AES-256-GCM shifrlangan
  encryptedToken    String? // joriy session token, har qurilma uchun unique
  userId            String? // SD foydalanuvchi ID

  status SalesDoctorStatus @default(DISCONNECTED)

  // Setup paytida operator tanlaydigan default SD reference'lar — `setOrder` da kerak
  defaultAgentSdId     String?
  defaultPriceTypeSdId String?
  defaultWarehouseSdId String?

  // Status mapping override: { "PENDING": 1, "PROCESSING": 2, ... }
  // Default null — backend default mapping ishlatadi.
  statusMap Json?

  lastSyncAt DateTime?
  lastError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SalesDoctorRetryStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

// Sales Doctor xato bo'lganda push'larni qayta urinish navbati.
// Worker har daqiqada PENDING + nextAttemptAt<=now ni topib qayta chaqiradi.
model SalesDoctorRetry {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  resourceType String // "order" | "customer" | "product"
  resourceId   String
  method       String // SD API method nomi (setOrder, setStatus, setClient, setProduct)
  payload      Json   // chaqiriqning full request body — qayta ishlatish uchun

  status        SalesDoctorRetryStatus @default(PENDING)
  attempts      Int                    @default(0)
  lastError     String?
  nextAttemptAt DateTime               @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status, nextAttemptAt])
  @@index([resourceType, resourceId])
}

// ============== 1C Integration (CommerceML 2 «Обмен с сайтом») ==============
//
// 1C on-prem ishlaydi va odatda NAT ortida — shuning uchun *biz* 1C'ga emas,
// 1C bizga ulanadi. 1C'ning standart "Обмен с сайтом" moduli belgilangan
// HTTP protokol bo'yicha ishlaydi:
//   GET  ?type=catalog&mode=checkauth   → cookie
//   GET  ?type=catalog&mode=init        → zip=no + file_limit
//   POST ?type=catalog&mode=file&filename=import.xml  → fayl (bo'laklab)
//   GET  ?type=catalog&mode=import&filename=import.xml → import (progress/success)
// Autentifikatsiya — HTTP Basic (login + parol), har tenant uchun alohida.

enum OneCStatus {
  DISCONNECTED
  CONNECTED
  ERROR
}

model OneCAccount {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // 1C "Обмен с сайтом" sozlamasiga kiritiladigan Basic auth login.
  // Global unique — exchange endpoint tenant'ni aynan shu login orqali topadi
  // (URL'da tenant ID ochilmaydi).
  login             String @unique
  encryptedPassword String // AES-256-GCM: "iv:authTag:ciphertext"

  status OneCStatus @default(DISCONNECTED)

  // Yangi mahsulot yashirin (active=false) holatda yaratiladimi.
  // Narx/qoldiq sinxroni hozircha yo'q — narxsiz mahsulot vitrinada
  // 0 so'mga chiqib qolmasligi uchun default true.
  createInactive Boolean @default(true)
  // <Картинка> fayllarini import qilish (1C import_files/ jo'natadi)
  importImages   Boolean @default(true)
  // 1C nomini/tavsifini mavjud mahsulot ustiga yozish (1C = manba haqiqat)
  overwriteNames Boolean @default(true)

  lastExchangeAt DateTime? // oxirgi har qanday so'rov (checkauth ham)
  lastImportAt   DateTime? // oxirgi muvaffaqiyatli katalog importi
  lastError      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Har bir `mode=import` yakuni — admin kartochkasidagi "oxirgi importlar" ro'yxati.
model OneCImportLog {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  filename String // "import.xml" | "offers.xml" | ...
  ok       Boolean @default(true)
  message  String? // xato matni yoki e'tibor talab qiladigan izoh

  categoriesCreated Int @default(0)
  categoriesUpdated Int @default(0)
  productsCreated   Int @default(0)
  productsUpdated   Int @default(0)
  productsHidden    Int @default(0) // 1C'da "Удален" belgilangan → active=false
  imagesImported    Int @default(0)

  durationMs Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
}

// MoySklad webhook'lardan keladigan event'lar idempotentlik uchun
model WebhookEvent {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source     String // "moysklad" | "telegram"
  externalId String // requestId yoki shunga o'xshash unik kalit
  entityType String? // "product" | "customerorder" | ...
  action     String? // "CREATE" | "UPDATE" | "DELETE"
  payload    Json
  processed  Boolean  @default(false)
  receivedAt DateTime @default(now())

  @@unique([tenantId, source, externalId])
  @@index([tenantId, processed])
}

// Push notifikatsiya obunalari — admin paneli yopiq bo'lsa ham yangi
// buyurtma haqida brauzer/OS push xabar oladi (Service Worker + Web Push).
model PushSubscription {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @db.Text
  p256dh    String
  authKey   String
  userAgent String?
  createdAt DateTime @default(now())
  lastUsedAt DateTime?

  @@unique([userId, endpoint])
  @@index([tenantId])
}

// ============== Outbound (chiquvchi) webhooklar ==============
// Tenant istalgan tashqi tizimga event yuborishi mumkin: order.created,
// order.status_changed, lead.created. Har biri HMAC-SHA256 imzo bilan.
model OutboundWebhook {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  url         String
  events      String[] // ["order.created", "order.status_changed", "lead.created"]
  // HMAC imzo uchun maxfiy kalit (shifrlangan) — ixtiyoriy
  encryptedSecret String?
  description String?
  active      Boolean  @default(true)

  // Diagnostika
  lastStatus   Int?
  lastFiredAt  DateTime?
  lastError    String?
  failureCount Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, active])
}

// ============== Sale campaign / Aksiya ==============
// Bir necha mahsulotni "Распродажа" / "Hit" / "Yangi" kabi yorliq bilan
// guruhlash uchun. Admin paneldan yaratiladi, Mini App'da har kartochkada
// rangli badge ko'rinadi.

enum SaleBadgeColor {
  RED // Распродажа
  ORANGE // Hot
  EMERALD // Yangi
  PURPLE // VIP
  BLUE // Premium
}

model SaleCampaign {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name       String
  label      String // Kartochkada ko'rinadigan matn, masalan "Распродажа"
  badgeColor SaleBadgeColor @default(RED)

  // Vaqt cheklovi (ixtiyoriy)
  active   Boolean   @default(true)
  startsAt DateTime?
  endsAt   DateTime?

  // Prioritet — agar mahsulot bir nechta campaignga tegishli bo'lsa, eng katta priority ko'rinadi
  priority Int @default(0)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, active])
}

enum PopupKind {
  MODAL // To'liq ekranli, dismiss talab qiladi
  BANNER // Tepasidagi katta, auto-collapse
  TOAST // Toast (kichik), ekranning yuqori qismida
}

enum PopupTrigger {
  ON_OPEN // App ochilganda (1 marta)
  AFTER_DELAY // X soniyadan keyin
  ON_TAB_CHANGE // Tab bosilganda (cart, profile, ...)
  ON_CART_ABANDON // Savatda mahsulot bor, lekin checkout qilinmagan (Phase 2)
}

model Popup {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  title    String
  body     String  @db.Text
  imageUrl String?
  ctaText  String? // "Xarid qilish", "Batafsil", ...
  ctaUrl   String? // ichki yo'l "/store/x/promotions" yoki tashqi URL

  kind            PopupKind    @default(MODAL)
  trigger         PopupTrigger @default(ON_OPEN)
  triggerDelaySec Int          @default(0) // AFTER_DELAY uchun

  // Faollik va jadval
  active   Boolean   @default(true)
  startsAt DateTime?
  endsAt   DateTime?

  // Bir foydalanuvchiga necha marta ko'rsatish (0 = cheksiz)
  maxImpressionsPerUser Int @default(1)
  // Ko'rsatishlar orasidagi minimal soat
  cooldownHours         Int @default(24)

  priority Int @default(0) // Yuqori → birinchi ko'rsatiladi

  // Analytika
  impressions Int @default(0)
  clicks      Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, active])
  @@index([tenantId, priority])
}

// ============== Cart abandonment ==============
// Mijoz savatga mahsulot qo'shsa, server'da saqlanadi. Scheduler 1 soat kechikkanda
// Telegram orqali "savatingiz kutmoqda" eslatma yuboradi.

model AbandonedCart {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Mijoz identifikatori
  telegramUserId BigInt
  customerName   String?

  // Savat tarkibi (JSON): [{ productId, qty, name, price, imageUrl }]
  items    Json
  total    Decimal @default(0) @db.Decimal(14, 2)
  currency String  @default("UZS")

  // Vaqt jadvali
  lastActiveAt   DateTime  @default(now())
  reminderSentAt DateTime?
  // Reminder maksimal qancha marta yuboriladi (default 1 — 1 ta eslatma)
  remindersSent  Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, telegramUserId])
  @@index([tenantId, lastActiveAt])
  @@index([reminderSentAt])
}

// ============== Product Combo / Add-ons ==============
// Amazon-style "Frequently bought together":
// Bir mahsulotga qo'shimcha mahsulotlar biriktiriladi. Mini App'da quick view'da
// "Bularni ham qo'shing" bo'limi paydo bo'ladi.

model ProductAddon {
  id       String @id @default(cuid())
  tenantId String

  // Asosiy mahsulot (uning quick view'ida add-on'lar ko'rinadi)
  mainProductId String
  mainProduct   Product @relation("ComboMain", fields: [mainProductId], references: [id], onDelete: Cascade)

  // Qo'shimcha mahsulot (savatga qo'shiladigan ekstra)
  addonProductId String
  addonProduct   Product @relation("ComboAddon", fields: [addonProductId], references: [id], onDelete: Cascade)

  // Tartib (kim birinchi ko'rinadi)
  position        Int     @default(0)
  // Combo bilan birga olinsa qancha foiz chegirma (0..100)
  discountPct     Int     @default(0)
  // Default tanlangan bo'lsinmi (true = checkbox tanlangan)
  defaultSelected Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([mainProductId, addonProductId])
  @@index([tenantId, mainProductId])
}

// ============== PROMO CODES ==============
// Chegirma kodlari — foiz yoki belgilangan summa chegirma.
// Storefront checkout'da qo'llaniladi.

enum PromoDiscountType {
  PERCENT   // foiz chegirma (5%, 10%, ...)
  FIXED     // belgilangan summa (10000 so'm)
}

model PromoCode {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  code        String  // Unikal kod (SAVE10, SUMMER25, ...)
  description String? // Admin uchun izoh

  discountType  PromoDiscountType @default(PERCENT)
  discountValue Decimal           @db.Decimal(10, 2) // foiz yoki summa
  maxDiscount   Decimal?          @db.Decimal(14, 2) // foiz uchun maksimal chegirma summa

  // Minimal buyurtma summasi
  minOrderAmount Decimal? @db.Decimal(14, 2)

  // Foydalanish limiti
  usageLimit    Int?     // umumiy necha marta ishlatiladi (null = cheksiz)
  usageCount    Int      @default(0)
  perUserLimit  Int      @default(1) // bitta foydalanuvchi necha marta

  // Amal qilish muddati
  startsAt DateTime?
  endsAt   DateTime?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usages PromoUsage[]
  orders Order[]      @relation("OrderPromo")

  @@unique([tenantId, code])
  @@index([tenantId, active])
}

model PromoUsage {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  promoCodeId String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orderId     String?   @unique
  order       Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  usedAt      DateTime  @default(now())

  @@index([tenantId, promoCodeId])
  @@index([customerId])
}

// ============== DELIVERY ==============
// Yetkazib berish zonalari, usullari va buyurtma yetkazish

model DeliveryZone {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name         String           // "Toshkent", "Toshkent viloyati", ...
  regions      String[]         // viloyat/tuman nomlari
  active       Boolean          @default(true)
  position     Int              @default(0)

  methods DeliveryMethod[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, active])
}

enum DeliveryMethodType {
  FREE         // bepul
  FLAT_RATE    // belgilangan narx
  BY_WEIGHT    // og'irlik bo'yicha
  BY_DISTANCE  // masofa bo'yicha
}

model DeliveryMethod {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  zoneId String?
  zone   DeliveryZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  name        String             // "Standart", "Tezkor", "Bepul"
  description String?
  type        DeliveryMethodType @default(FLAT_RATE)
  price       Decimal            @default(0) @db.Decimal(14, 2)
  // Bepul yetkazish uchun minimal summa (0 = doim bepul)
  freeAbove   Decimal?           @db.Decimal(14, 2)
  // Yetkazish vaqti (kun)
  minDays     Int                @default(1)
  maxDays     Int                @default(3)

  active    Boolean  @default(true)
  position  Int      @default(0)

  deliveryOrders DeliveryOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, active])
  @@index([zoneId])
}

enum DeliveryStatus {
  PENDING     // Kutilmoqda
  ASSIGNED    // Kuryer tayinlangan
  PICKED_UP   // Olib ketildi
  IN_TRANSIT  // Yo'lda
  DELIVERED   // Yetkazildi
  FAILED      // Yetkazib bo'lmadi
  RETURNED    // Qaytarildi
}

model DeliveryOrder {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  orderId  String @unique
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  methodId String?
  method   DeliveryMethod? @relation(fields: [methodId], references: [id], onDelete: SetNull)

  status       DeliveryStatus @default(PENDING)
  trackingCode String?
  courierName  String?
  courierPhone String?
  notes        String?

  // Narx
  price    Decimal @default(0) @db.Decimal(14, 2)
  currency String  @default("UZS")

  // Sana va vaqt
  scheduledAt DateTime?
  pickedUpAt  DateTime?
  deliveredAt DateTime?
  failedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([orderId])
}

// ============== API KEYS ==============
model ApiKey {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name       String
  keyHash    String
  prefix     String
  scopes     String[] @default([])
  lastUsedAt DateTime?
  expiresAt  DateTime?
  active     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, active])
  @@index([keyHash])
}

// ============== NOTIFICATION SETTINGS ==============
model TenantNotifSettings {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  notifyOrdersGroupId     String?
  notifyOrdersEnabled     Boolean @default(true)
  notifyLeadsEnabled      Boolean @default(true)
  notifyReviewsEnabled    Boolean @default(true)
  notifyAbandonedEnabled  Boolean @default(true)
  emailNotificationsEnabled Boolean @default(false)
  emailRecipients         String[] @default([])

  // Admin Telegram — yangi buyurtma/lid kelganda admin o'z telegramiga xabar oladi
  adminTelegramChatId     BigInt?

  // Avtomatik email hisobotlar
  reportFrequency    String?   // "daily" | "weekly" | "monthly" | null = off
  lastReportSentAt   DateTime?

  updatedAt DateTime @updatedAt
}

// ============== LOYALTY (BALL TIZIMI) ==============

model LoyaltyAccount {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  balance    Int @default(0) // Joriy ball miqdori
  totalEarned Int @default(0)
  totalSpent  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions LoyaltyTransaction[]

  @@index([tenantId])
  @@index([customerId])
}

enum LoyaltyTxType {
  EARN    // Xariddan ball to'plash
  SPEND   // Ballarni sarflash (chegirma)
  EXPIRE  // Muddat o'tgan ballar
  ADJUST  // Admin tomonidan qo'lda o'zgartirish
  BONUS   // Bonus (tug'ilgan kun va h.k.)
}

model LoyaltyTransaction {
  id        String            @id @default(cuid())
  tenantId  String
  accountId String
  account   LoyaltyAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)

  type      LoyaltyTxType
  amount    Int               // Musbat = qo'shildi, manfiy = ayirildi
  balance   Int               // Bu operatsiyadan keyingi balans
  description String?
  orderId   String?           // Agar xariddan to'plangan bo'lsa

  expiresAt DateTime?         // Ball qachon muddati tugaydi
  createdAt DateTime @default(now())

  @@index([tenantId, accountId])
  @@index([orderId])
}

model LoyaltyRule {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String
  description String?
  type        String   // "purchase", "birthday", "referral", "first_order"

  // Xariddan to'plash: har 1000 so'mga necha ball
  earnPerAmount     Int?     // har earnPerThreshold so'mga earnPerAmount ball
  earnPerThreshold  Int?     // default 1000

  // Sarflash: necha ball = 1 so'm chegirma
  redeemRate Int?     // 1 ball = redeemRate so'm

  active    Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, active])
}

// ============== BOT VORONKA (SALES FUNNEL) ==============

enum BotSequenceTrigger {
  NEW_CUSTOMER    // Mijoz birinchi /start bosishi yoki ro'yxatdan o'tishi
  FIRST_PURCHASE  // Birinchi buyurtma yakunlanganda
  INACTIVE_DAYS   // N kun davomida xarid qilmagan
  VIP_STATUS      // Mijoz VIP maqomiga o'tganda
  BIRTHDAY        // Tug'ilgan kun (yillik qayta ishlaydi)
  WEEKLY          // Har hafta belgilangan kun — reklama/eslatma
}

model BotSequence {
  id           String             @id @default(cuid())
  tenantId     String
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  trigger      BotSequenceTrigger
  inactiveDays Int?               // faqat INACTIVE_DAYS uchun
  weekDay      Int?               // faqat WEEKLY uchun: 0=Yak, 1=Du, ..., 5=Ju, 6=Sha
  active       Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  steps       BotSequenceStep[]
  enrollments BotSequenceEnrollment[]

  @@index([tenantId, active])
}

model BotSequenceStep {
  id         String      @id @default(cuid())
  sequenceId String
  sequence   BotSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  stepOrder  Int
  delayHours Int         @default(0)
  message    String

  @@index([sequenceId, stepOrder])
}

model BotSequenceEnrollment {
  id          String      @id @default(cuid())
  sequenceId  String
  sequence    BotSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  currentStep Int         @default(0)
  nextSendAt  DateTime?
  completed   Boolean     @default(false)
  enrolledAt  DateTime    @default(now())

  @@unique([sequenceId, customerId])
  @@index([nextSendAt, completed])
  @@index([customerId])
}

// ============== REFRESH TOKENS ==============
model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  lastUsedAt DateTime?
  revokedAt DateTime?
  userAgent String?
  ipAddress String?

  @@index([userId])
  @@index([tokenHash])
}
