// ShopFlow multi-tenant schema
// Har bir tenant — alohida tashkilot. Barcha business rows tenant_id ga bog'langan.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============== TENANT & AUTH ==============

model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  currency  String   @default("UZS")
  timezone  String   @default("Asia/Tashkent")
  locale    String   @default("uz")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  leads           Lead[]
  orders          Order[]
  products        Product[]
  customers       Customer[]
  channels        Channel[]
  interactions    Interaction[]
  categories      Category[]
  storefront      Storefront?
  moyskladAccount MoyskladAccount?
  syncJobs        SyncJob[]
  webhookEvents   WebhookEvent[]
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  AGENT
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String
  passwordHash String
  name         String
  role         UserRole @default(AGENT)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedLeads  Lead[]  @relation("LeadAssignee")
  assignedOrders Order[] @relation("OrderAssignee")

  @@unique([tenantId, email])
  @@index([tenantId])
}

// ============== CHANNELS ==============
// Channel — tenantning marketing/lead manbai (Telegram bot, Instagram page, web form, ...)

enum ChannelType {
  WEBSITE
  LANDING_PAGE
  INSTAGRAM
  TELEGRAM
  FACEBOOK
  WHATSAPP
  EMAIL
  PHONE
  REFERRAL
  GOOGLE_ADS
  YANDEX_DIRECT
  MARKETPLACE
  OFFLINE
}

model Channel {
  id         String      @id @default(cuid())
  tenantId   String
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type       ChannelType
  name       String
  config     Json        @default("{}")
  webhookKey String      @unique @default(cuid()) // tenantga xos webhook URL kaliti
  active     Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  leads  Lead[]
  orders Order[]

  @@index([tenantId, type])
}

// ============== CRM: LEAD ==============

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum LeadPriority {
  HIGH
  MEDIUM
  LOW
}

model Lead {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code        String // human-readable, "LID-2024001"
  name        String
  phone       String?
  email       String?
  company     String?
  position    String?
  location    String?
  status      LeadStatus   @default(NEW)
  priority    LeadPriority @default(MEDIUM)
  value       Decimal      @default(0) @db.Decimal(14, 2)
  currency    String       @default("UZS")
  notes       String?
  tags        String[]     @default([])
  utmSource   String?
  utmMedium   String?
  utmCampaign String?

  channelId String?
  channel   Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  assigneeId String?
  assignee   User?   @relation("LeadAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  lastContactAt  DateTime?
  nextFollowUpAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  interactions Interaction[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, channelId])
  @@index([tenantId, createdAt])
}

enum InteractionType {
  CALL
  EMAIL
  SMS
  WHATSAPP
  TELEGRAM
  MEETING
  NOTE
  STATUS_CHANGE
}

enum InteractionDirection {
  INBOUND
  OUTBOUND
}

model Interaction {
  id        String               @id @default(cuid())
  tenantId  String
  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId    String
  lead      Lead                 @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      InteractionType
  direction InteractionDirection
  content   String
  duration  Int? // sekundlarda (qo'ng'iroq/uchrashuv uchun)
  createdBy String // user name yoki "system"
  createdAt DateTime             @default(now())

  @@index([tenantId, leadId, createdAt])
}

// ============== CATALOG ==============

model Category {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryTree")
  createdAt DateTime   @default(now())

  // MoySklad sync uchun (productfolder)
  moyskladId      String?
  moyskladUpdated DateTime?

  products Product[]

  @@unique([tenantId, slug])
  @@unique([tenantId, moyskladId])
  @@index([tenantId])
}

model Product {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sku         String
  name        String
  description String?
  price       Decimal  @default(0) @db.Decimal(14, 2)
  oldPrice    Decimal? @db.Decimal(14, 2) // chegirma uchun (eski narx)
  currency    String   @default("UZS")
  stock       Int      @default(0)
  active      Boolean  @default(true)
  featured    Boolean  @default(false) // Vitrina'da ko'rsatish uchun bayroq
  imageUrl    String? // asosiy rasm URL
  images      String[] @default([]) // qo'shimcha rasmlar

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // MoySklad sync uchun
  moyskladId      String?
  moyskladUpdated DateTime?
  source          ProductSource @default(MANUAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]

  @@unique([tenantId, sku])
  @@unique([tenantId, moyskladId])
  @@index([tenantId, active])
  @@index([tenantId, featured])
}

enum ProductSource {
  MANUAL
  MOYSKLAD
}

// ============== STOREFRONT (Vitrina) ==============
// Har bir tenantning bitta Vitrina layout'i bor.
// Vitrina — bu Telegram Mini App, web katalog va veb-sayt uchun
// umumiy konfiguratsiya: bloklar tartibi, brand sozlamalari.

model Storefront {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Bloklar tartibi va sozlamalari (drag-drop builder natijasi)
  // Misol: [{ id, type, title, enabled, settings: {...} }]
  blocks Json @default("[]")

  // Brand sozlamalari: logo, ranglar, shrift
  // { name, logoUrl, primaryColor, secondaryColor, contactPhone, ... }
  brand Json @default("{}")

  // Public bo'lib turishi (sayt yopilishi mumkin)
  published Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============== CUSTOMERS ==============

model Customer {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  location  String?
  notes     String?
  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Telegram Mini App orqali tanish — keyinchalik "Mening buyurtmalarim"
  telegramUserId BigInt?

  // MoySklad sync uchun (counterparty)
  moyskladId      String?
  moyskladUpdated DateTime?

  orders Order[]

  @@unique([tenantId, moyskladId])
  @@index([tenantId, email])
  @@index([tenantId, phone])
  @@index([tenantId, telegramUserId])
}

// ============== ORDERS ==============

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
  REFUNDED
}

model Order {
  id       String      @id @default(cuid())
  tenantId String
  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code     String // "ORD-7523"
  status   OrderStatus @default(PENDING)
  total    Decimal     @default(0) @db.Decimal(14, 2)
  currency String      @default("UZS")
  notes    String?

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  channelId String?
  channel   Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  assigneeId String?
  assignee   User?   @relation("OrderAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  // MoySklad sync uchun (customerorder)
  moyskladId       String?
  moyskladUpdated  DateTime?
  pushedToMoysklad Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]

  @@unique([tenantId, code])
  @@unique([tenantId, moyskladId])
  @@index([tenantId, status])
  @@index([tenantId, channelId])
  @@index([tenantId, createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  qty       Int
  price     Decimal @db.Decimal(14, 2)

  @@index([orderId])
}

// ============== MoySklad Integration ==============

enum MoyskladStatus {
  DISCONNECTED
  CONNECTING
  CONNECTED
  ERROR
}

model MoyskladAccount {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // AES-256-GCM bilan shifrlangan bearer token: "iv:authTag:ciphertext" (hex)
  encryptedToken String
  accountUuid    String?
  accountName    String?
  status         MoyskladStatus @default(DISCONNECTED)

  connectedAt   DateTime?
  lastSyncAt    DateTime?
  lastWebhookAt DateTime?
  lastError     String?

  // Sync uchun cursor — keyingi marta shu vaqtdan keyin o'zgartirilganlarini olamiz
  productsSyncCursor  DateTime?
  customersSyncCursor DateTime?
  ordersSyncCursor    DateTime?

  // MoySklad'ga ro'yxatdan o'tkazgan webhook'lar id'lari (uzilish/qayta ulanishda tozalash uchun)
  webhookIds String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SyncJobType {
  INITIAL_IMPORT
  INCREMENTAL_PRODUCTS
  INCREMENTAL_CUSTOMERS
  INCREMENTAL_ORDERS
  PUSH_ORDER
}

enum SyncJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

model SyncJob {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type           SyncJobType
  status         SyncJobStatus @default(QUEUED)
  progress       Int           @default(0) // 0..100
  totalItems     Int           @default(0)
  processedItems Int           @default(0)
  startedAt      DateTime?
  finishedAt     DateTime?
  error          String?
  details        Json          @default("{}")
  createdAt      DateTime      @default(now())

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

// MoySklad webhook'lardan keladigan event'lar idempotentlik uchun
model WebhookEvent {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source     String // "moysklad" | "telegram"
  externalId String // requestId yoki shunga o'xshash unik kalit
  entityType String? // "product" | "customerorder" | ...
  action     String? // "CREATE" | "UPDATE" | "DELETE"
  payload    Json
  processed  Boolean  @default(false)
  receivedAt DateTime @default(now())

  @@unique([tenantId, source, externalId])
  @@index([tenantId, processed])
}
